{
  "Principal": {
      "uid": {
        "type": "UID",
        "config": { "label": "UID" }
      },
      "title": {
        "type": "Text",
        "config": { "label": "Título", "placeholder": "Winn — We Innovate" }
      },
      "client": {
        "type": "Text",
        "config": { "label": "Cliente", "placeholder": "Bolsa de Comercio de Rosario" }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Categoría",
          "options": [
            "Branding e Identidad",
            "Digital y UX/UI",
            "Packaging y Retail"
          ]
        }
      },
      "year": {
        "type": "Text",
        "config": { "label": "Año", "placeholder": "2023 o 2019–2025" }
      },
      "discipline": {
        "type": "Text",
        "config": {
          "label": "Disciplina",
          "placeholder": "Identidad de marca · UI/UX · Lanzamiento · Plataforma B2B"
        }
      },
      "cover": {
        "type": "Image",
        "config": { "label": "Imagen de portada", "constraint": {}, "thumbnails": [] }
      }
    },
    "Contenido": {
      "summary": {
        "type": "StructuredText",
        "config": {
          "label": "Resumen",
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "challenge": {
        "type": "StructuredText",
        "config": {
          "label": "El desafío",
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "role": {
        "type": "StructuredText",
        "config": {
          "label": "Mi rol",
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "process": {
        "type": "Group",
        "config": {
          "label": "Proceso",
          "fields": {
            "step": {
              "type": "Text",
              "config": { "label": "Etapa" }
            }
          }
        }
      },
      "outcome": {
        "type": "StructuredText",
        "config": {
          "label": "Resultado (opcional)",
          "single": "paragraph,strong,em,hyperlink"
        }
      }
    },
    "Estadísticas": {
      "stats": {
        "type": "Group",
        "config": {
          "label": "Estadísticas",
          "fields": {
            "value": {
              "type": "Text",
              "config": { "label": "Valor", "placeholder": "UI/UX" }
            },
            "label": {
              "type": "Text",
              "config": { "label": "Descripción", "placeholder": "Interfaz y experiencia de usuario" }
            }
          }
        }
      }
    },
    "SEO y metadatos": {
      "meta_title": {
        "type": "Text",
        "config": { "label": "Título SEO" }
      },
      "meta_description": {
        "type": "Text",
        "config": { "label": "Descripción SEO" }
      },
      "meta_image": {
        "type": "Image",
        "config": { "label": "Imagen para redes sociales", "constraint": {}, "thumbnails": [] }
      }
    }
}
