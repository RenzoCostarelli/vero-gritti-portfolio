---
import type { PortfolioDocument } from "../types/prismic";

interface Props {
  project: PortfolioDocument;
  index?: number;
  className?: string;
}

const { project, index, className } = Astro.props;
const { title, category, year, cover } = project.data;
---

<a href={`/portfolio/${project.uid}`} class:list={["group block", className]}>
  <div
    class="relative aspect-[4/3] w-full overflow-hidden rounded-md bg-neutral-100"
  >
    <img
      src={cover.url || "/placeholder.svg"}
      alt={cover.alt || title || ""}
      sizes="(max-width: 768px) 100vw, 50vw"
      class="object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
    <div
      class="absolute inset-0 bg-foreground/0 transition-colors duration-500 group-hover:bg-foreground/10"
    >
    </div>
  </div>

  <div
    class="mt-5 flex items-start justify-between gap-6 border-t border-border pt-4"
  >
    <div>
      <h3 class="font-serif text-xl font-light tracking-tight md:text-2xl">
        {title}
      </h3>
      <p class="mt-1 text-sm text-muted-foreground">
        {category}
      </p>
    </div>
    <div class="text-right">
      {
        typeof index === "number" && (
          <span class="font-mono text-xs text-muted-foreground">
            {String(index + 1).padStart(2, "0")}
          </span>
        )
      }
      <p class="mt-1 text-sm text-muted-foreground">{year}</p>
    </div>
  </div>
</a>
