---
const { project, index, className } = Astro.props;
---

<a href={`/portfolio/${project.slug}`} class:list={["group block", className]}>
  <div class="relative aspect-[4/3] w-full overflow-hidden rounded-sm bg-muted">
    <img
      src={project.cover || "/placeholder.svg"}
      alt={project.title}
      sizes="(max-width: 768px) 100vw, 50vw"
      class="object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
    <div
      class="absolute inset-0 bg-foreground/0 transition-colors duration-500 group-hover:bg-foreground/10"
    >
    </div>
  </div>

  <div
    class="mt-5 flex items-start justify-between gap-6 border-t border-border pt-4"
  >
    <div>
      <h3 class="font-serif text-xl font-light tracking-tight md:text-2xl">
        {project.title}
      </h3>
      <p class="mt-1 text-sm text-muted-foreground">
        {project.category}
      </p>
    </div>
    <div class="text-right">
      {
        typeof index === "number" && (
          <span class="font-mono text-xs text-muted-foreground">
            {String(index + 1).padStart(2, "0")}
          </span>
        )
      }
      <p class="mt-1 text-sm text-muted-foreground">{project.year}</p>
    </div>
  </div>
</a>
