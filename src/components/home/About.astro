---
import { asText } from "@prismicio/client";
import { createClient } from "../../lib/prismicio";
import type { HomeDocument } from "../../types/prismic";
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";

const client = createClient();
const page = await client.getSingle<HomeDocument>("home");
const {
  about_eyebrow,
  photo,
  heading,
  paragraph_1,
  paragraph_2,
  paragraph_3,
  facts,
} = page.data;

const photoUrl =
  photo.url ??
  "https://res.cloudinary.com/dkgnaegp9/image/upload/v1785334078/My_Identity_AVATAR_skdojr.jpg";
const photoAlt = photo.alt ?? "Retrato de Verónica Rositto Gritti";
---

<section id="about" class="border-t border-border px-5 py-24 md:px-10 md:py-32">
  <div class="mx-auto grid container gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <Reveal>
        <p
          class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
        >
          {about_eyebrow}
        </p>
      </Reveal>
      <Reveal delay={0.05} class="mt-8">
        <div
          class="relative aspect-square w-full overflow-hidden rounded-md bg-neutral-100 shadow-2xl"
        >
          <img
            src={photoUrl}
            alt={photoAlt}
            sizes="(max-width: 1024px) 100vw, 40vw"
            class="object-cover w-full h-full"
          />
        </div>
      </Reveal>
    </div>

    <div class="lg:col-span-8 lg:pt-12">
      <TextReveal
        as="h2"
        text={asText(heading)}
        class="font-serif text-3xl tracking-tight sm:text-4xl md:text-[2.8rem] text-pretty"
      />

      <div
        class="mt-8 max-w-4xl space-y-5 text-pretty leading-relaxed text-muted-foreground"
      >
        <Reveal as="p">{asText(paragraph_1)}</Reveal>
        <Reveal as="p" delay={0.08}>{asText(paragraph_2)}</Reveal>
        <Reveal as="p" delay={0.4}>{asText(paragraph_3)}</Reveal>
      </div>

      <div
        class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-sm bg-background sm:grid-cols-6"
      >
        {
          facts.map((fact, i) => (
            <Reveal
              delay={i * 0.06}
              class="bg-background p-5 border-r border-border last:border-r-0"
            >
              <p class="font-serif text-2xl font-light tracking-tight">
                {fact.value}
              </p>
              <p class="mt-2 text-xs leading-snug text-muted-foreground">
                {fact.label}
              </p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </div>
</section>
