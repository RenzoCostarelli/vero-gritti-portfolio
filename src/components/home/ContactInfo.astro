---
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";
---

<section
  id="contact"
  class="border-t border-border px-5 py-24 md:px-10 md:py-32"
>
  <div class="mx-auto grid container gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
        (05) Get in touch
      </p>
      <TextReveal
        as="h2"
        text="Available for Brand Strategy Lead, Head of Design or Creative Direction roles."
        class="mt-6 max-w-3xl font-serif text-3xl font-light leading-[1.12] tracking-tight sm:text-4xl md:text-5xl"
      />
      <Reveal
        as="p"
        delay={0.05}
        class="mt-6 max-w-xl text-pretty leading-relaxed text-muted-foreground"
      >
        At creative agencies, strategic consultancies or brand-led
        organisations. Open to international roles.
      </Reveal>
      <Reveal delay={0.1} class="mt-10">
        <a
          href="/contact"
          class="group inline-flex items-center gap-3 rounded-full bg-foreground px-7 py-3.5 text-sm text-background transition-colors hover:bg-accent"
        >
          Contact me
        </a>
      </Reveal>
    </div>

    <div class="space-y-8 lg:col-span-5 lg:border-l lg:border-border lg:pl-12">
      {
        [
          {
            label: "Email",
            value: "hola@veronicarosittogritti.com",
            href: "mailto:hola@veronicarosittogritti.com",
          },
          {
            label: "Phone",
            value: "+54 9 341 515 0801",
            href: "tel:+5493415150801",
          },
          {
            label: "LinkedIn",
            value: "/in/veronicarosittogritti",
            href: "https://linkedin.com/in/veronicarosittogritti",
          },
        ].map((item, i) => (
          <Reveal delay={i * 0.08}>
            <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
              {item.label}
            </p>
            <a
              href={item.href}
              target={item.label === "LinkedIn" ? "_blank" : undefined}
              rel={
                item.label === "LinkedIn" ? "noopener noreferrer" : undefined
              }
              class="group mt-2 inline-flex items-center gap-1 font-serif text-xl font-light tracking-tight transition-colors hover:text-accent"
            >
              {item.value}
            </a>
          </Reveal>
        ))
      }
      <Reveal delay={0.24}>
        <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
          Based in
        </p>
        <p class="mt-2 font-serif text-xl font-light tracking-tight">
          Rosario, Argentina
        </p>
      </Reveal>
    </div>
  </div>
</section>
