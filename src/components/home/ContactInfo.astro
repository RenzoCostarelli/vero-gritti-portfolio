---
import { asLink } from "@prismicio/client";
import { createClient, linkResolver } from "../../lib/prismicio";
import type { HomeDocument } from "../../types/prismic";
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";

const client = createClient();
const page = await client.getSingle<HomeDocument>("home");
const {
  heading_main,
  heading_secondary,
  email,
  phone,
  linkedin_label,
  linkedin_url,
  location,
} = page.data;

const contactItems = [
  { label: "Email", value: email, href: `mailto:${email}`, external: false },
  {
    label: "Teléfono",
    value: phone,
    href: `tel:${(phone ?? "").replace(/\s+/g, "")}`,
    external: false,
  },
  {
    label: "LinkedIn",
    value: linkedin_label,
    href: asLink(linkedin_url, { linkResolver }) ?? "#",
    external: true,
  },
];
---

<section
  id="contact"
  class="border-t border-border px-5 py-24 md:px-10 md:py-32"
>
  <div class="mx-auto grid container gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2
        class="mt-6 font-serif font-light leading-[1.12] tracking-tight md:text-[1.65rem] flex flex-col"
      >
        <TextReveal as="span" text={heading_main ?? ""} />
        {" "}
        <TextReveal
          as="span"
          text={heading_secondary ?? ""}
          class="italic text-foreground/40"
        />
      </h2>
    </div>

    <div class="space-y-8 lg:col-span-5 lg:border-l lg:border-border lg:pl-12">
      {
        contactItems.map((item, i) => (
          <Reveal delay={i * 0.08}>
            <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
              {item.label}
            </p>
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="group mt-2 inline-flex items-center gap-1 font-serif text-xl font-light tracking-tight transition-colors hover:text-accent"
            >
              {item.value}
            </a>
          </Reveal>
        ))
      }
      <Reveal delay={0.24}>
        <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
          Basada en
        </p>
        <p class="mt-2 font-serif text-xl font-light tracking-tight">
          {location}
        </p>
      </Reveal>
    </div>
  </div>
</section>
