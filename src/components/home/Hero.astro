---
const lines = ["Brand thinking", "that holds up", "at scale."];
---

<section
  class="relative flex flex-col justify-between px-5 pb-10 pt-32 md:px-10 md:pt-60 md:pb-16"
>
  <div class="mx-auto flex w-full container flex-1 flex-col justify-center">
    <h1
      class="font-serif text-[clamp(2.75rem,3vw,3.05rem)] font-light leading-[0.92] tracking-[-0.02em]"
    >
      {
        lines.map((line, i) => (
          <span data-line class="mr-3">
            <span class="inline-block will-change-transform">
              {i === 1 ? (
                <em class="font-serif italic text-accent">{line}</em>
              ) : (
                line
              )}
            </span>
          </span>
        ))
      }
    </h1>

    <div
      class="mt-3 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between md:ml-1"
    >
      <p
        data-fade
        class="text-pretty text-[clamp(1.2rem,0.5vw,1rem)] max-w-3xl leading-none text-neutral-900"
      >
        I translate business decisions into coherenty visual system and sustain
        them at scale, without losing strategic focus or execution quality
      </p>
    </div>
  </div>
</section>
