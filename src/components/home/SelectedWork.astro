---
import { createClient } from "../../lib/prismicio";
import type { HomeDocument, PortfolioDocument } from "../../types/prismic";
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";
import ProjectCard from "../ProjectCard.astro";

const client = createClient();
const page = await client.getSingle<HomeDocument>("home");
const { work_eyebrow, work_heading, link_label, featured_projects } =
  page.data;

const projectLinks = featured_projects.map((item) => item.project);
const projectIds = projectLinks
  .filter(
    (link): link is Extract<typeof link, { link_type: "Document" }> =>
      link.link_type === "Document",
  )
  .map((link) => link.id);

const projectDocs = projectIds.length
  ? await client.getByIDs<PortfolioDocument>(projectIds)
  : null;

const featured = projectIds
  .map((id) => projectDocs?.results.find((doc) => doc.id === id))
  .filter((doc): doc is PortfolioDocument => Boolean(doc));
---

<section class="border-t border-border px-5 py-24 md:px-10 md:py-32">
  <div class="mx-auto container">
    <div
      class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end"
    >
      <div>
        <p
          class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
        >
          {work_eyebrow}
        </p>
        <TextReveal
          as="h2"
          text={work_heading ?? ""}
          class="mt-6 max-w-2xl font-serif text-3xl font-light leading-[1.12] tracking-tight sm:text-4xl md:text-5xl"
        />
      </div>
      <Reveal>
        <a
          href="/portfolio"
          class="group inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          {link_label}
        </a>
      </Reveal>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2">
      {
        featured.map((project, i) => (
          <Reveal delay={(i % 2) * 0.08}>
            <ProjectCard project={project} index={i} />
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
