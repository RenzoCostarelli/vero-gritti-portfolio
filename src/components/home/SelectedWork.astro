---
import { projects } from "../../lib/data/prjects";
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";
import ProjectCard from "../ProjectCard.astro";
const featured = projects.slice(0, 4);
---

<section class="border-t border-border px-5 py-24 md:px-10 md:py-32">
  <div class="mx-auto container">
    <div
      class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end"
    >
      <div>
        <p
          class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
        >
          (03) Selected work
        </p>
        <TextReveal
          as="h2"
          text="Identity systems built to last."
          class="mt-6 max-w-2xl font-serif text-3xl font-light leading-[1.12] tracking-tight sm:text-4xl md:text-5xl"
        />
      </div>
      <Reveal>
        <a
          href="/portfolio"
          class="group inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          All projects
        </a>
      </Reveal>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2">
      {
        featured.map((project, i) => (
          <Reveal delay={(i % 2) * 0.08}>
            <ProjectCard project={project} index={i} />
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
