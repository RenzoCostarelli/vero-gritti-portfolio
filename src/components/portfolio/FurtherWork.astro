---
import { furtherWork } from "../../lib/data/prjects";
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";
---

<section class="border-t border-border px-5 py-24 md:px-10 md:py-28">
  <div class="mx-auto max-w-7xl">
    <p class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
      Further selected work
    </p>
    <TextReveal
      as="h2"
      text="More projects across sectors."
      class="mt-6 max-w-2xl font-serif text-3xl font-light leading-[1.12] tracking-tight sm:text-4xl"
    />

    <div
      class="mt-14 grid gap-px overflow-hidden rounded-sm border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        furtherWork.map((item, i) => (
          <Reveal
            delay={(i % 3) * 0.06}
            class="bg-background p-7"
          >
            <h3 class="font-serif text-xl font-light tracking-tight">
              {item.title}
            </h3>
            <p class="mt-3 text-pretty text-sm leading-relaxed text-muted-foreground">
              {item.description}
            </p>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
