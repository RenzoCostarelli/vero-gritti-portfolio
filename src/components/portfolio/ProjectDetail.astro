---
import { asText, isFilled } from "@prismicio/client";
import type { PortfolioDocument } from "../../types/prismic";
import Reveal from "../animations/Reveal.astro";
import TextReveal from "../animations/TextReveal.astro";

interface Props {
  project: PortfolioDocument;
  next: PortfolioDocument;
}

const { project } = Astro.props;
const {
  title,
  category,
  year,
  client,
  summary,
  discipline,
  cover,
  challenge,
  role,
  process,
  outcome,
} = project.data;
---

<article>
  <!-- Header -->
  <header class="px-5 pb-10 pt-36 md:px-10 md:pb-14 md:pt-44">
    <div class="mx-auto max-w-7xl">
      <Reveal>
        <a
          href="/portfolio"
          class="group inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform group-hover:-translate-x-1"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Todos los proyectos
        </a>
      </Reveal>

      <div
        class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] uppercase tracking-[0.2em] text-muted-foreground"
      >
        <span>{category}</span>
        <span class="h-1 w-1 rounded-full bg-accent"></span>
        <span>{year}</span>
        <span class="h-1 w-1 rounded-full bg-accent"></span>
        <span>{client}</span>
      </div>

      <TextReveal
        as="h1"
        text={title ?? ""}
        class="mt-6 max-w-5xl font-serif text-[clamp(2.25rem,6vw,5rem)] font-light leading-[1] tracking-tight"
      />

      <Reveal
        as="p"
        delay={0.1}
        class="mt-8 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground"
      >
        {asText(summary)}
      </Reveal>

      <Reveal delay={0.16} class="mt-6 text-sm text-muted-foreground">
        {discipline}
      </Reveal>
    </div>
  </header>

  <!-- Cover image with parallax -->
  <div
    data-parallax-wrap
    class="relative mx-5 aspect-[16/10] overflow-hidden rounded-sm bg-muted md:mx-10 lg:aspect-[16/8]"
  >
    <img
      data-parallax-img
      src={cover.url || "/placeholder.svg"}
      alt={cover.alt || title || ""}
      class="absolute inset-0 h-[115%] w-full object-cover will-change-transform"
    />
  </div>

  <!-- Challenge & Role -->
  <section class="border-t border-border px-5 py-20 md:px-10 md:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p
          class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
        >
          El desafío
        </p>
        <p
          class="mt-6 text-pretty text-xl font-light leading-relaxed md:text-2xl"
        >
          {asText(challenge)}
        </p>
      </div>
      <div>
        <p
          class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
        >
          Mi rol
        </p>
        <p class="mt-6 text-pretty leading-relaxed text-muted-foreground">
          {asText(role)}
        </p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="border-t border-border px-5 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-7xl">
      <p class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
        Proceso
      </p>
      <ul class="mt-10 border-t border-border">
        {
          process.map((item, i) => (
            <Reveal
              as="li"
              delay={i * 0.05}
              class="group flex items-baseline gap-6 border-b border-border py-6 transition-colors hover:text-accent md:gap-10 md:py-8"
            >
              <span class="font-mono text-xs text-muted-foreground">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="font-serif text-2xl font-light tracking-tight transition-transform duration-500 group-hover:translate-x-2 md:text-3xl">
                {item.step}
              </span>
            </Reveal>
          ))
        }
      </ul>

      {
        isFilled.richText(outcome) && (
          <Reveal class="mt-14 max-w-3xl border-l-2 border-accent pl-6">
            <p class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
              Resultado
            </p>
            <p class="mt-4 text-pretty text-xl font-light leading-relaxed md:text-2xl">
              {asText(outcome)}
            </p>
          </Reveal>
        )
      }
    </div>
  </section>
</article>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";

  function initParallax() {
    ScrollTrigger.getAll()
      .filter((t) => t.trigger?.hasAttribute("data-parallax-wrap"))
      .forEach((t) => t.kill());

    const wrap = document.querySelector<HTMLElement>("[data-parallax-wrap]");
    const img = document.querySelector<HTMLElement>("[data-parallax-img]");
    if (!wrap || !img) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    gsap.fromTo(
      img,
      { yPercent: -6 },
      {
        yPercent: 6,
        ease: "none",
        scrollTrigger: {
          trigger: wrap,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      },
    );
  }

  initParallax();
  document.addEventListener("astro:page-load", initParallax);
</script>
