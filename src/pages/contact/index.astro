---
import Layout from "../../layouts/Layout.astro";
import Reveal from "../../components/animations/Reveal.astro";
import TextReveal from "../../components/animations/TextReveal.astro";
import ContactForm from "../../components/contact/ContactForm.astro";
import ContactInfo from "../../components/home/ContactInfo.astro";

const contactItems = [
  {
    label: "Email",
    value: "hola@veronicarosittogritti.com",
    href: "mailto:hola@veronicarosittogritti.com",
    external: false,
  },
  {
    label: "Phone",
    value: "+54 9 341 515 0801",
    href: "tel:+5493415150801",
    external: false,
  },
  {
    label: "LinkedIn",
    value: "/in/veronicarosittogritti",
    href: "https://linkedin.com/in/veronicarosittogritti",
    external: true,
  },
] as const;
---

<Layout
  title="Contact — Verónica Rositto Gritti"
  description="Available for Brand Strategy Lead, Head of Design or Creative Direction roles at creative agencies, strategic consultancies or brand-led organisations."
>
  <!-- Header -->
  <header class="px-5 pb-10 pt-36 md:px-10 md:pb-14 md:pt-44">
    <div class="mx-auto container">
      <Reveal>
        <p
          class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
        >
          Contact
        </p>
      </Reveal>
      <TextReveal
        as="h1"
        text="Let's start with a conversation."
        class="mt-6 max-w-3xl font-serif text-[clamp(2.5rem,6vw,5rem)] font-light leading-[1] tracking-tight"
      />
      <Reveal delay={0.1}>
        <p
          class="mt-6 max-w-xl text-pretty leading-relaxed text-muted-foreground"
        >
          Available for Brand Strategy Lead, Head of Design or Creative
          Direction roles at creative agencies, strategic consultancies or
          brand-led organisations.
        </p>
      </Reveal>
    </div>
  </header>

  <!-- Main section -->
  <section class="border-t border-border px-5 py-20 md:px-10 md:py-28">
    <div class="mx-auto grid container gap-16 lg:grid-cols-12">
      <!-- Contact info -->
      <div class="lg:col-span-4">
        <div class="space-y-10">
          {
            contactItems.map((item, i) => (
              <Reveal delay={i * 0.08}>
                <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                  {item.label}
                </p>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="mt-2 inline-block font-serif text-xl font-light tracking-tight transition-colors hover:text-accent"
                >
                  {item.value}
                </a>
              </Reveal>
            ))
          }
          <Reveal delay={0.24}>
            <p
              class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground"
            >
              Based in
            </p>
            <p class="mt-2 font-serif text-xl font-light tracking-tight">
              Rosario, Argentina
            </p>
          </Reveal>
          <Reveal delay={0.32}>
            <p
              class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground"
            >
              Response time
            </p>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              I typically respond within 24 hours.
            </p>
          </Reveal>
        </div>
      </div>

      <!-- Vertical divider (desktop) -->
      <div class="hidden lg:col-span-1 lg:flex lg:justify-center">
        <div class="w-px bg-border"></div>
      </div>

      <!-- Horizontal divider (mobile/tablet) -->
      <div class="lg:hidden"></div>

      <!-- Form -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>
    </div>
  </section>

  <ContactInfo />
</Layout>
