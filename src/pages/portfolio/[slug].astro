---
import { createClient } from "../../lib/prismicio";
import type { PortfolioDocument } from "../../types/prismic";
import Layout from "../../layouts/Layout.astro";
import ProjectDetail from "../../components/portfolio/ProjectDetail.astro";
import ContactInfo from "../../components/home/ContactInfo.astro";
import { asText } from "@prismicio/client";

export async function getStaticPaths() {
  const client = createClient();
  const projects = await client.getAllByType<PortfolioDocument>("portfolio");

  return projects.map((project, index) => {
    const next = projects[(index + 1) % projects.length];
    return {
      params: { slug: project.uid },
      props: { project, next },
    };
  });
}

interface Props {
  project: PortfolioDocument;
  next: PortfolioDocument;
}

const { project, next } = Astro.props;
---

<Layout
  title={`${project.data.title} — Verónica Rositto Gritti`}
  description={asText(project.data.summary)}
>
  <ProjectDetail project={project} next={next} />
  <ContactInfo />
</Layout>
