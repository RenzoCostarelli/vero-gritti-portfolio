---
import TextReveal from "../../components/animations/TextReveal.astro";
import ContactInfo from "../../components/home/ContactInfo.astro";
import PortfolioGrid from "../../components/portfolio/PortfolioGrid.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Portfolio — Verónica Rositto Gritti">
  <header class="px-5 pb-10 pt-36 md:px-10 md:pb-14 md:pt-44">
    <div class="mx-auto container">
      <p class="text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
        Portfolio
      </p>
      <TextReveal
        as="h1"
        text="Selected projects across identity, digital and brand communication."
        class="mt-6 max-w-4xl font-serif text-[clamp(2rem,5vw,4rem)] font-light leading-[1.05] tracking-tight"
      />
    </div>
  </header>

  <PortfolioGrid />
  <ContactInfo />
</Layout>
